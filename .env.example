# Required in production. Long and random: it signs every session token.
AUTH_SECRET=

# memory (default, per-process, lost on restart) or mongo
DB_DRIVER=memory
# DB_DRIVER=mongo needs this:
MONGO_URL=
MONGO_DB=hobile

# With DB_DRIVER=memory, a path here keeps state across restarts.
DATA_FILE=

# Where the client is served from. Set it in production; "*" is dev only.
CORS_ORIGIN=*

PORT=2567
MAX_PLAYERS_PER_ZONE=60

# GM accounts: usernames, comma-separated. Registered accounts only — a name
# nobody has registered yet goes to whoever registers it first.
ADMIN_USERS=
