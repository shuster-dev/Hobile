{
  "name": "hobile-online",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Hobile Online — browser/PWA monster-collecting MMO",
  "scripts": {
    "build": "node tools/build.mjs && node tools/build.mjs --solo",
    "build:solo": "node tools/build.mjs --solo",
    "build:web": "node tools/build.mjs",
    "dev": "node src/server/index.js",
    "look": "node tools/build.mjs --solo && node tools/look.mjs",
    "qa": "node tools/qa.mjs",
    "shot": "node tools/shot.mjs",
    "start": "node src/server/index.js",
    "test": "npm run qa && npm run test:server",
    "test:browser": "node tools/build.mjs --solo && node tools/smoke.mjs",
    "test:camera": "node tools/build.mjs --solo && node tools/camera-test.mjs",
    "test:live": "node tools/session-test.mjs",
    "test:play": "node tools/build.mjs --solo && node tools/play.mjs",
    "test:server": "node tools/server-test.mjs",
    "test:session": "node tools/build.mjs && node tools/session-test.mjs",
    "test:store": "node tools/store-test.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "express": "4.21.2",
    "mongodb": "6.12.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/generator": "7.25.0",
    "@babel/parser": "7.25.3",
    "@babel/traverse": "7.25.3",
    "@gltf-transform/cli": "^4.5.0",
    "colyseus.js": "0.16.22",
    "esbuild": "0.23.1",
    "playwright": "^1.63.0",
    "prettier": "3.3.3",
    "sharp": "^0.35.4",
    "three": "0.185.1"
  },
  "engines": {
    "node": ">=20"
  }
}
