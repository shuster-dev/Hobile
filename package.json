  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus.js": "0.16.22",
    "express": "4.21.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/generator": "7.25.0",
    "@babel/parser": "7.25.3",
    "@babel/traverse": "7.25.3",
    "esbuild": "0.23.1",
    "playwright": "^1.63.0",
    "prettier": "3.3.3"
  }
}
